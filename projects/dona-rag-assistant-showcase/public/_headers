/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: document-domain=(), geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.groq.com https://pagead2.googlesyndication.com; frame-src 'self' https://googleads.g.doubleclick.net;

/logo.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/style.css
  Cache-Control: public, max-age=86400, must-revalidate

/app.js
  Cache-Control: public, max-age=86400, must-revalidate

/Dona_Codex_Kurumsal_Sartname.pdf
  Cache-Control: public, max-age=604800, must-revalidate
  Content-Type: application/pdf

